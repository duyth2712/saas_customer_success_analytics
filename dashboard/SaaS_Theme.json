{
    "name": "B2B SaaS Modern Theme",
    "dataColors": [
        "#1D4ED8", 
        "#10B981", 
        "#F59E0B", 
        "#EF4444", 
        "#8B5CF6", 
        "#3B82F6", 
        "#14B8A6", 
        "#64748B"
    ],
    "visualStyles": {
        "*": {
            "*": {
                "outspacePane": [{ "backgroundColor": {"solid": {"color": "#F3F4F6"}} }],
                "background": [{ "show": true, "color": {"solid": {"color": "#FFFFFF"}}, "transparency": 0 }],
                "visualHeader": [{ "show": true }],
                "border": [{ "show": true, "color": {"solid": {"color": "#E5E7EB"}}, "radius": 8 }]
            }
        },
        "page": {
            "*": {
                "background": [{ "color": {"solid": {"color": "#F8FAFC"}}, "transparency": 0 }]
            }
        }
    }
}